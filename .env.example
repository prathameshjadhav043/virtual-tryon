# ==========================================
# Root Environment Reference (.env.example)
# ==========================================

# ------------------------------------------
# Frontend (/web/.env)
# ------------------------------------------
# URL of your deployed or local Cloudflare Worker backend
VITE_TRYON_WORKER_URL=http://localhost:8787

# Firebase Project Configuration (Free Spark Plan)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ------------------------------------------
# Cloudflare Worker (/worker/.dev.vars)
# ------------------------------------------
# Allowed origin for CORS (e.g. http://localhost:5173 for local dev, or https://<your-project>.web.app for prod)
ALLOWED_ORIGIN=http://localhost:5173

# Hugging Face Space ID for virtual try-on
HF_SPACE=yisol/IDM-VTON

# Optional Hugging Face Token (increases queue priority and allows access to gated/private spaces)
HF_TOKEN=hf_your_token_here
